{
  "name": "netease",
  "version": "1.0.0",
  "description": "Netease automated coupon scheduler",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "dev": "tsx run.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "esbuild run.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --sourcemap",
    "start": "node dist/index.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dayjs": "^1.11.23",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
